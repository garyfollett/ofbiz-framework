<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
        elementFormDefault="qualified">

    <!--
    Agent tool contract configuration.

    The XML describes only the agent-facing semantic contract for an
    existing OFBiz service. It does not define or implement the OFBiz
    business service itself.

    The structure maps directly to AgentToolContract:

        scalar -> AgentToolContract.ValueKind.SCALAR
        object -> AgentToolContract.ValueKind.OBJECT
        list   -> AgentToolContract.ValueKind.LIST

    Primitive scalar conversion is performed separately by
    AgentValueCodec.
    -->

    <xs:element name="agent-tool-contracts">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="agent-tool"
                        type="agentToolType"
                        minOccurs="1"
                        maxOccurs="unbounded"/>
            </xs:sequence>

            <xs:attribute name="version"
                    type="xs:string"
                    use="required"/>
        </xs:complexType>

        <!--
        A service name may have only one agent tool contract within
        a configuration document.
        -->
        <xs:unique name="uniqueAgentToolServiceName">
            <xs:selector xpath="agent-tool"/>
            <xs:field xpath="@service-name"/>
        </xs:unique>
    </xs:element>

    <!--
    One governed agent-facing contract for one OFBiz service.
    -->
    <xs:complexType name="agentToolType">
        <xs:sequence>
            <xs:element name="result"
                    type="resultType"/>
        </xs:sequence>

        <xs:attribute name="service-name"
                type="nonBlankString"
                use="required"/>
    </xs:complexType>

    <!--
    OFBiz service results are named maps, therefore the root result
    must always be an object.
    -->
    <xs:complexType name="resultType">
        <xs:sequence>
            <xs:element name="object"
                    type="objectType"/>
        </xs:sequence>
    </xs:complexType>

    <!--
    An object contains one or more explicitly declared fields.

    Fields not declared here are outside the agent-facing contract.
    -->
    <xs:complexType name="objectType">
        <xs:sequence>
            <xs:element name="field"
                    type="fieldType"
                    minOccurs="1"
                    maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!--
    A field has exactly one value definition:
        scalar
        object
        list

    required="true" means that the source object must contain the key.
    It does not mean that the value itself must be non-null.
    -->
    <xs:complexType name="fieldType">
        <xs:choice>
            <xs:element name="scalar"
                    type="scalarType"/>

            <xs:element name="object"
                    type="objectType"/>

            <xs:element name="list"
                    type="listType"/>
        </xs:choice>

        <xs:attribute name="name"
                type="nonBlankString"
                use="required"/>

        <xs:attribute name="required"
                type="xs:boolean"
                default="true"/>
    </xs:complexType>

    <!--
    A list has exactly one item definition. Every list item must
    conform to that same definition.
    -->
    <xs:complexType name="listType">
        <xs:choice>
            <xs:element name="scalar"
                    type="scalarType"/>

            <xs:element name="object"
                    type="objectType"/>

            <xs:element name="list"
                    type="listType"/>
        </xs:choice>
    </xs:complexType>

    <!--
    The semantic type is an OFBiz semantic field type understood by
    AgentValueCodec, for example:

        currency-amount
        currency-precise
        fixed-point
        date
        date-time
        time
        id
        name
        integer

    The XSD intentionally does not enumerate these values.

    AgentValueCodec remains the authoritative runtime definition of
    supported semantic types. This prevents the XSD and Java codec
    from independently maintaining duplicate type lists.
    -->
    <xs:complexType name="scalarType">
        <xs:attribute name="semantic-type"
                type="nonBlankString"
                use="required"/>
    </xs:complexType>

    <!--
    String containing at least one non-whitespace character.
    -->
    <xs:simpleType name="nonBlankString">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:pattern value=".*\S.*"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
