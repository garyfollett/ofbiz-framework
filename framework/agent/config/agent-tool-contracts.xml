<agent-tool-contracts
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="agent-tool-contracts.xsd"
        version="1.0">

    <!--
    Agent-facing semantic contract for the OFBiz service:

        getCustomerOverdueInvoices

    This configuration defines only the business data permitted to cross
    from the OFBiz service result into the agent/model boundary.

    Normal Service Engine metadata such as responseMessage is deliberately
    not declared and therefore is not part of the model-visible result.
    -->
    <agent-tool service-name="getCustomerOverdueInvoices">

        <result>
            <object>

                <field name="partyName"
                        required="true">
                    <scalar semantic-type="name"/>
                </field>

                <field name="invoicePaymentInfoList"
                        required="true">

                    <list>
                        <object>

                            <field name="invoiceId"
                                    required="true">
                                <scalar semantic-type="id"/>
                            </field>

                            <field name="amount"
                                    required="true">
                                <scalar semantic-type="currency-amount"/>
                            </field>

                            <field name="paidAmount"
                                    required="true">
                                <scalar semantic-type="currency-amount"/>
                            </field>

                            <field name="outstandingAmount"
                                    required="true">
                                <scalar semantic-type="currency-amount"/>
                            </field>

                            <field name="dueDate"
                                    required="true">
                                <scalar semantic-type="date-time"/>
                            </field>

                        </object>
                    </list>

                </field>

            </object>
        </result>

    </agent-tool>

</agent-tool-contracts>
