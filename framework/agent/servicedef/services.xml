<!--
The important parts are:
- engine="agent" selects the engine you registered earlier.
- invoke="CUSTOMER_ACCOUNT_ANALYST" links this service to the seeded agent metadata.
- auth="true" requires an authenticated OFBiz user.
- use-transaction="false" ensures the outer service does not begin a database transaction before the LLM call.
- partyId is the authoritative customer scope.
- summary is the only business output from this V1 agent service.

-->

<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">

    <description>OFBiz Agent Services</description>
    <vendor>OFBiz</vendor>
    <version>1.0</version>

    <service name="analyseCustomerAccount"
            engine="agent"
            invoke="CUSTOMER_ACCOUNT_ANALYST"
            auth="true"
            use-transaction="false">
        <description>Analyse a customer account using the configured OFBiz agent.</description>

        <attribute name="partyId"
                   type="String"
                   mode="IN"
                   optional="false"/>

        <attribute name="summary"
                   type="String"
                   mode="OUT"
                   optional="false"/>
    </service>

</services>