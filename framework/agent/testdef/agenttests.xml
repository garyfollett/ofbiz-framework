<test-suite suite-name="agenttests"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/test-suite.xsd">

    <!--
        Shared deterministic business data for both AgentServiceEngine tests.

        When either test case is selected individually through ofbiz minus minus test,
        ModelTestSuite automatically includes this preceding entity data-load
        case as its prerequisite.
    -->
    <test-case case-name="agent-integration-test-data-load">
        <entity-xml
                action="load"
                entity-xml-url="component://agent/testdef/data/AgentIntegrationTestData.xml"/>
    </test-case>

    <!--
        Deterministic integration test.

        The OFBiz service stack and semantic boundary are real. Only the
        external OpenAI-compatible endpoint is replaced by a deterministic
        local HTTP server.
    -->
    <test-case case-name="agent-service-engine-integration">
        <jupiter-test-suite
                class-name="org.apache.ofbiz.agent.AgentServiceEngineIntegrationTest"/>
    </test-case>

    <!--
        Live end-to-end acceptance test.

        This uses the configured agent.llm.baseUrl and agent.llm.model without
        substituting a fake endpoint. The Java test itself requires
        OFBIZ_AGENT_VLLM_E2E=true before it will execute.
    -->
    <test-case case-name="agent-service-engine-vllm-end-to-end">
        <jupiter-test-suite
                class-name="org.apache.ofbiz.agent.AgentServiceEngineVllmEndToEndTest"/>
    </test-case>

</test-suite>
