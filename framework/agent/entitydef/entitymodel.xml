<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">

    <title>Agent Entity Model</title>
    <description>Metadata for OFBiz-native AI agents and their permitted OFBiz service tools.</description>
    <version>1.0</version>

    <entity entity-name="AgentDefinition"
            package-name="org.apache.ofbiz.agent"
            title="Agent Definition">
        <field name="agentId" type="id-long"/>
        <field name="description" type="description"/>
        <field name="systemPrompt" type="very-long"/>
        <prim-key field="agentId"/>
    </entity>

    <entity entity-name="AgentTool"
            package-name="org.apache.ofbiz.agent"
            title="Agent Tool">
        <field name="agentId" type="id-long"/>
        <field name="serviceName" type="name"/>
        <prim-key field="agentId"/>
        <prim-key field="serviceName"/>
        <relation type="one"
                  fk-name="AGENT_TOOL_DEF"
                  rel-entity-name="AgentDefinition">
            <key-map field-name="agentId"/>
        </relation>
    </entity>

</entitymodel>