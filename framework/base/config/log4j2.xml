<Configuration monitorInterval="60" packages="org.apache.ofbiz.base.log4j">

    <!--
      Source line numbers in log output are enabled by default.

      To disable for production, set/uncomment:

          systemProp.ofbiz.env=prod

      in gradle.properties.
    -->
    <Properties>

        <Property name="lineToken_dev">:%line</Property>
        <Property name="lineToken_prod"></Property>

        <Property name="includeLocation_dev">true</Property>
        <Property name="includeLocation_prod">false</Property>

        <!--
          Normal OFBiz log pattern.

          The correlation fields are conditional. They therefore add nothing
          to ordinary OFBiz log records when no corresponding ThreadContext
          value exists.

          requestId:
              Existing OFBiz HTTP-request correlation identifier.

          agentRunId:
              Unique identifier for one governed agent execution.

          agentId:
              Registered OFBiz agent identifier.

          agentService:
              OFBiz service whose engine="agent" invocation started the run.

          Because these values live in Log4j ThreadContext, ordinary OFBiz
          logging produced synchronously while an agent is executing can be
          correlated with the agent execution without modifying the underlying
          OFBiz services.
        -->
        <Property name="logPattern">%date{DEFAULT} |%-20.20thread |%-30.30logger{1}${lineToken_${sys:ofbiz.env:-dev}}|%level{length=1}| %notEmpty{[REQ:%X{requestId}] }%notEmpty{[RUN:%X{agentRunId}] }%notEmpty{[AGENT:%X{agentId}] }%notEmpty{[AGENT-SVC:%X{agentService}] }%notEmpty{[TEST:%X{testCase}] }%message%n</Property>

        <!--
          Dedicated human-readable agent trace pattern.

          AgentTrace already includes structured event names such as:

              AGENT_START
              LLM_REQUEST
              TOOL_CALL_START
              TOOL_CALL_RESULT
              TX_PARENT_RESUMED
              AGENT_SUCCESS

          Correlation identifiers remain separate logging fields rather than
          being manually repeated in every AgentTrace message.
        -->
        <Property name="agentLogPattern">%date{DEFAULT} |%-20.20thread |%-30.30logger{1}${lineToken_${sys:ofbiz.env:-dev}}|%level{length=1}| %notEmpty{[REQ:%X{requestId}] }%notEmpty{[RUN:%X{agentRunId}] }%notEmpty{[AGENT:%X{agentId}] }%notEmpty{[SERVICE:%X{agentService}] }%message%n</Property>

        <Property name="includeLocation">${includeLocation_${sys:ofbiz.env:-dev}}</Property>

        <!--
          Placeholder for the JSON event template used by the opt-in
          structured logging appender below.

          Defaults to the bundled ECS template.

          To use a different schema (for example Splunk or CloudWatch), ship a
          template JSON file in the appropriate component config directory and
          point json.logs.template at it in:

              framework/base/config/debug.properties

          The default ./gradlew ofbiz command picks that up directly.
        -->
        <Property name="jsonLogTemplateUri">${sys:ofbiz.json.logs.template:-classpath:templates/ecs-layout.json}</Property>

    </Properties>

    <!--
      Existing OFBiz URI-specific dynamic logging filter.
    -->
    <OFBizDynamicThresholdFilter key="uri" onMatch="ACCEPT" onMismatch="DENY">
        <KeyValuePair key="/getJs" value="ERROR"/>
        <KeyValuePair key="/control/getJs" value="ERROR"/>
    </OFBizDynamicThresholdFilter>

    <!--
      Default configuration for logging.

      Normal OFBiz behaviour remains:

       * external libraries at warning or greater are logged to ofbiz.log
         and the console;

       * OFBiz messages at all configured severities are logged to ofbiz.log
         and the console;

       * error or greater messages are additionally logged to error.log;

       * structured ECS logging remains opt-in;

       * the agent component additionally receives its own dedicated
         runtime/logs/agent.log file.

      The configuration is monitored every 60 seconds. For the first agent
      runtime test, however, a full OFBiz restart is preferred so both the Java
      changes and logging configuration are known to be active together.
    -->

    <Appenders>

        <!--
          Standard console output.
        -->
        <Console name="stdout" target="SYSTEM_OUT">
            <PatternLayout pattern="${logPattern}"/>
        </Console>

        <!--
          Standard OFBiz application log.
        -->
        <RollingFile
                name="ofbiz"
                fileName="runtime/logs/ofbiz.log"
                filePattern="runtime/logs/ofbiz.log.%i">

            <PatternLayout pattern="${logPattern}"/>

            <Policies>
                <OnStartupTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>

            <DefaultRolloverStrategy
                    fileIndex="min"
                    max="30"/>

        </RollingFile>

        <!--
          Standard OFBiz error log.
        -->
        <RollingFile
                name="error"
                fileName="runtime/logs/error.log"
                filePattern="runtime/logs/error.log.%i">

            <ThresholdFilter
                    level="error"
                    onMatch="ACCEPT"
                    onMismatch="DENY"/>

            <PatternLayout pattern="${logPattern}"/>

            <Policies>
                <OnStartupTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>

            <DefaultRolloverStrategy
                    fileIndex="min"
                    max="10"/>

        </RollingFile>

        <!--
          Dedicated agent trace log.

          This file is deliberately separate from ofbiz.log so normal agent
          fault-finding can begin with:

              tail -f runtime/logs/agent.log

          Agent package messages continue to propagate to the normal OFBiz
          appenders as well through logger additivity.

          Rollover policy:
              10 MB per file
              30 files retained
        -->
        <RollingFile
                name="agentFile"
                fileName="runtime/logs/agent.log"
                filePattern="runtime/logs/agent.log.%i">

            <PatternLayout pattern="${agentLogPattern}"/>

            <Policies>
                <OnStartupTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>

            <DefaultRolloverStrategy
                    fileIndex="min"
                    max="30"/>

        </RollingFile>

        <!--
          Opt-in structured ECS JSON logging.

          Disabled by default, so this contributes no additional disk or CPU
          cost unless explicitly enabled.

          Controlled by:

              json.logs.enabled

          in:

              framework/base/config/debug.properties

          When enabled, output is written to:

              runtime/logs/ofbiz-json.log

          ThreadContext/MDC values such as requestId, agentRunId, agentId and
          agentService are available to the ECS JSON template.
        -->
        <Select>

            <SystemPropertyArbiter
                    propertyName="ofbiz.json.logs"
                    propertyValue="true">

                <RollingFile
                        name="jsonFile"
                        fileName="runtime/logs/ofbiz-json.log"
                        filePattern="runtime/logs/ofbiz-json.log.%i">

                    <JsonTemplateLayout eventTemplateUri="${jsonLogTemplateUri}">

                        <EventTemplateAdditionalField
                                key="service.name"
                                value="ofbiz"/>

                        <EventTemplateAdditionalField
                                key="service.environment"
                                value="${sys:ofbiz.env:-dev}"/>

                    </JsonTemplateLayout>

                    <Policies>
                        <OnStartupTriggeringPolicy/>
                        <SizeBasedTriggeringPolicy size="10 MB"/>
                    </Policies>

                    <DefaultRolloverStrategy
                            fileIndex="min"
                            max="30"/>

                </RollingFile>

            </SystemPropertyArbiter>

        </Select>

        <!--
          Existing asynchronous OFBiz logging path.
        -->
        <Async
                name="async"
                includeLocation="${includeLocation}">

            <AppenderRef ref="ofbiz"/>
            <AppenderRef ref="stdout"/>
            <AppenderRef ref="error"/>

            <Select>

                <SystemPropertyArbiter
                        propertyName="ofbiz.json.logs"
                        propertyValue="true">

                    <AppenderRef ref="jsonFile"/>

                </SystemPropertyArbiter>

            </Select>

        </Async>

        <!--
          Dedicated asynchronous agent logging path.

          Keeping the agent file behind an Async appender avoids making normal
          agent execution wait on synchronous disk writes merely because
          tracing is enabled.
        -->
        <Async
                name="agentAsync"
                includeLocation="${includeLocation}">

            <AppenderRef ref="agentFile"/>

        </Async>

    </Appenders>

    <Loggers>

        <!--
          Existing logger hierarchy.
        -->
        <logger
                name="org.apache"
                level="warn"/>

        <logger
                name="org.apache.ofbiz"
                level="all"/>

        <!--
          Dedicated agent component logger.

          additivity="true" is intentional.

          Agent events therefore go to:

              runtime/logs/agent.log

          and also continue through the parent OFBiz logger/root path to:

              runtime/logs/ofbiz.log
              console
              error.log where applicable
              ofbiz-json.log when enabled

          This gives us a focused trace without removing the agent events from
          the normal OFBiz diagnostic record.
        -->
        <logger
                name="org.apache.ofbiz.agent"
                level="all"
                additivity="true">

            <AppenderRef ref="agentAsync"/>

        </logger>

        <logger
                name="org.apache.ofbiz.base.converter.Converters"
                level="warn"/>

        <logger
                name="freemarker"
                level="warn"/>

        <Root level="all">

            <AppenderRef ref="async"/>

        </Root>

    </Loggers>

</Configuration>

